{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build",
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "https://stockpulse-production-d3c4.up.railway.app/api/$1"
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}